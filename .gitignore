.env.local
.env.*.local
server/.env

# ===== 日志 =====
*.log
npm-debug.log*
yarn-error.log*
logs/

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ===== 临时文件 =====
*.tmp
*.temp
tmp/
__tmp*
scripts-tmp*
.tmpbuild/
